      { "name": "to", "kind": "recipient", "required": true, "max_length": 320 },
      { "name": "tls_mode", "kind": "enum", "required": false },
      { "name": "subject_prefix", "kind": "string", "required": false, "max_length": 128 }
    ]
  },
  "secret_fields": ["password_ref"],
  "endpoint_templates": [],
  "capabilities": ["alert_delivery", "test_delivery"],
  "publication": { "status": "planned", "installable": false, "crp_binding": "descriptor-only" }
