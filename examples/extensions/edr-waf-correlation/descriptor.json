{
  "api_version": "crp.cheesewaf.io/extensions/v1",
  "descriptor_id": "official-edr-waf-correlation-1.0.0",
  "plugin_id": "edr-waf-correlation",
  "class": "event-correlator",
  "deployment": "local-sidecar",
  "runtime": "sidecar",
  "version": "1.0.0",
  "namespace": "official/edr",
  "source": "future-contract",
  "source_root": "vendor-root-v1",
  "capabilities": ["observe", "evidence", "risk_hint", "health"],
  "input": {
    "schema": "cheesewaf/waf-security-event/v1",
    "data_class": "waf-security-event",
    "redaction_profile": "metadata-only",
    "max_bytes": 65536,
    "host_telemetry": false
  },
  "output": {
    "schemas": ["cheesewaf/edr-evidence/v1", "cheesewaf/risk-hint/v1"],
    "direct_actions": [],
    "max_bytes": 32768,
    "ttl_seconds": 900
  },
  "network": {
    "mode": "deny",
    "allowed_targets": [],
    "lease": { "required": false, "max_ttl_seconds": 0, "max_requests": 0, "max_bytes": 0 }
  },
  "activation": {
    "request_path": "asynchronous",
    "initial_mode": "observe",
    "activation_owner": "control-plane"
  },
  "deployment_config": { "provider": "cheesewaf" },
  "resources": { "cpu_milli": 300, "memory_bytes": 268435456, "pids": 48 },
  "publication": { "status": "planned", "installable": false, "crp_binding": "descriptor-only" }
}
