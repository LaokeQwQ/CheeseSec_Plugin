{
  "api_version": "crp.cheesewaf.io/extensions/v1",
  "descriptor_id": "official-duckdb-analysis-1.0.0",
  "plugin_id": "duckdb-analysis",
  "class": "analytics",
  "deployment": "host-provided",
  "runtime": "sidecar",
  "version": "1.0.0",
  "namespace": "official/duckdb",
  "source": "future-contract",
  "source_root": "vendor-root-v1",
  "capabilities": ["observe", "analysis_record", "candidate_snapshot", "health"],
  "input": {
    "schema": "cheesewaf/audit-parquet/v1",
    "data_class": "redacted-audit-snapshot",
    "redaction_profile": "parquet-minimized",
    "max_bytes": 104857600,
    "host_telemetry": false
  },
  "output": {
    "schemas": ["cheesewaf/analysis-record/v1", "cheesewaf/candidate-snapshot/v1"],
    "direct_actions": [],
    "max_bytes": 1048576,
    "ttl_seconds": 3600
  },
  "network": {
    "mode": "deny",
    "allowed_targets": [],
    "lease": { "required": false, "max_ttl_seconds": 0, "max_requests": 0, "max_bytes": 0 }
  },
  "activation": {
    "request_path": "asynchronous",
    "initial_mode": "observe",
    "activation_owner": "control-plane"
  },
  "deployment_config": {
    "provider": "duckdb",
    "version_range": ">=1.3.0 <2.0.0",
    "artifact_policy": "host-provided",
    "persistent_database": false,
    "query_policy_ref": "duckdb-read-only-snapshot-v1"
  },
  "resources": { "cpu_milli": 1000, "memory_bytes": 1073741824, "pids": 64 },
  "publication": { "status": "planned", "installable": false, "crp_binding": "descriptor-only" }
}
