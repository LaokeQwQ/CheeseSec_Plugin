{
  "name": "cheesesec-publication",
  "main": "edge/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "rules": [
    { "type": "Text", "globs": ["**/storefront/*.html", "**/storefront/*.css", "**/storefront/*.js", "**/storefront/*.mjs", "**/storefront/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/storefront/*.png"], "fallthrough": true }
  ],
  "r2_buckets": [
    { "binding": "PUBLICATION_INDEX", "bucket_name": "cheesesec-publication-index-prod" },
    { "binding": "PUBLIC_RESOURCES", "bucket_name": "cheesesec-public-resources-prod" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVICE_COUNTERS", "class_name": "ServiceCounters" }]
  },
  "migrations": [{ "tag": "service-counters-v1", "new_sqlite_classes": ["ServiceCounters"] }],
  "vars": { "EDGE_POLICY_VERSION": "store-ota-v1" },
  "routes": [
    { "pattern": "store.cheesesec.com", "custom_domain": true },
    { "pattern": "ota.cheesesec.com", "custom_domain": true },
    { "pattern": "res.cheesesec.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
