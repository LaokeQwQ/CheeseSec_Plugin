{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.cheesesec.com/schema/store/v1/trust-roots.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "roots"],
  "properties": {
    "api_version": { "const": "store.cheesesec.com/v1" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key", "trust_level", "source_root", "status", "valid_from", "valid_until"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
          "algorithm": { "const": "ed25519" },
          "public_key": { "type": "string", "minLength": 43, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
          "trust_level": { "enum": ["official", "enterprise", "community", "personal", "test", "development"] },
          "source_root": { "type": "string", "pattern": "^(?!.*[.][.])[A-Za-z0-9:/._@+-]+$" },
          "status": { "enum": ["active", "suspended", "revoked"] },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_until": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
