{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.cheesesec.com/schema/crp/v1/signatures.schema.json",
  "title": "CheeseWAF CRP v1 signature set",
  "description": "Strict JSON array used by signatures/manifest.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key_id",
      "algorithm",
      "value",
      "source_root",
      "trust_level",
      "release_sequence",
      "manifest_sha256",
      "signed_at",
      "expires_at"
    ],
    "properties": {
      "key_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "algorithm": {
        "const": "ed25519"
      },
      "value": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      },
      "source_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!.*[.][.])[A-Za-z0-9:/._@+-]+$"
      },
      "trust_level": {
        "enum": ["official", "enterprise", "community", "personal", "test", "development"]
      },
      "release_sequence": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      },
      "manifest_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "signed_at": {
        "type": "string",
        "format": "date-time"
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
