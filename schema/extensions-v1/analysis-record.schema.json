{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.cheesesec.com/schema/extensions/v1/analysis-record.schema.json",
  "title": "CheeseWAF analysis record v1",
  "description": "Read-only DuckDB analysis output. It cannot change the source audit snapshot or enforce policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "record_id", "plugin_id", "plugin_version", "snapshot_ref", "generated_at", "window", "findings", "recommendations", "integrity"],
  "properties": {
    "api_version": { "const": "cheesewaf/analysis-record/v1" },
    "record_id": { "$ref": "#/$defs/id" },
    "plugin_id": { "$ref": "#/$defs/id" },
    "plugin_version": { "$ref": "#/$defs/version" },
    "snapshot_ref": { "$ref": "#/$defs/id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "count", "evidence_refs"],
        "properties": {
          "code": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "subject_hash": { "$ref": "#/$defs/sha256" },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 100,
      "items": { "enum": ["observe", "contain", "isolate", "review"] }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[.][.])[A-Za-z0-9:/._@+-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+([.][0-9]+){0,2}([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$" }
  }
}
