{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.cheesesec.com/schema/extensions/v1/waf-security-event.schema.json",
  "title": "CheeseWAF WAF security event v1",
  "description": "Minimal redacted event input for the EDR correlation profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "event_id", "event_type", "observed_at", "tenant_ref", "site_ref", "source_instance_ref", "stream_ref", "sequence", "route_ref", "subject_hash", "severity", "count", "window_seconds", "evidence_refs", "metadata"],
  "properties": {
    "api_version": { "const": "cheesewaf/waf-security-event/v1" },
    "event_id": { "$ref": "#/$defs/id" },
    "event_type": { "enum": ["waf_rule_hit", "auth_failure", "challenge_failed", "rate_limit_exceeded", "origin_error"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "$ref": "#/$defs/id" },
    "site_ref": { "$ref": "#/$defs/id" },
    "source_instance_ref": { "$ref": "#/$defs/id" },
    "stream_ref": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "route_ref": { "$ref": "#/$defs/id" },
    "subject_hash": { "$ref": "#/$defs/sha256" },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "window_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_family", "method_class", "status_class", "challenge_result", "auth_factor"],
      "properties": {
        "rule_family": { "enum": ["none", "injection", "bot", "protocol", "custom", "auth", "rate-limit", "origin"] },
        "method_class": { "enum": ["read", "write", "other"] },
        "status_class": { "enum": ["1xx", "2xx", "3xx", "4xx", "5xx", "none"] },
        "challenge_result": { "enum": ["not-applicable", "passed", "failed", "expired"] },
        "auth_factor": { "enum": ["not-applicable", "password", "totp", "token", "mfa", "unknown"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[.][.])[A-Za-z0-9:/._@+-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
