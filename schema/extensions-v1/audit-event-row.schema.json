{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.cheesesec.com/schema/extensions/v1/audit-event-row.schema.json",
  "title": "CheeseWAF minimized audit event row v1",
  "description": "Logical schema of the fixed columns exposed by the audit Parquet relation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["occurred_at", "event_type", "tenant_ref", "site_ref", "route_ref", "subject_hash", "severity", "evidence_refs", "count"],
  "properties": {
    "occurred_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "event_type": { "enum": ["waf_rule_hit", "auth_failure", "challenge_failed", "rate_limit_exceeded", "origin_error"] },
    "tenant_ref": { "$ref": "#/$defs/id" },
    "site_ref": { "$ref": "#/$defs/id" },
    "route_ref": { "$ref": "#/$defs/id" },
    "subject_hash": { "$ref": "#/$defs/sha256" },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
    },
    "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[.][.])[A-Za-z0-9:/._@+-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
